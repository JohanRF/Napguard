{
  "name": "napguard",
  "version": "1.0.4",
  "description": "App de concentración con timer Pomodoro",
  "main": "main.js",
  "author": "Johan Rivera",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.napguard.app",
    "productName": "NapGuard",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/images/napguard.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "config/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
